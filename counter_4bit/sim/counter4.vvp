    %vpi_call 2 160 "$display", "  *** FAILURES DETECTED ***" {0 0 0};
T_5.13 ;
    %vpi_call 2 161 "$display", "==============================================" {0 0 0};
    %vpi_call 2 163 "$finish" {0 0 0};
    %end;
    .thread T_5;
